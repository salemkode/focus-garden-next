{
  "name": "@focus-garden/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Posts the Focus Garden leaderboard to Telegram from a Cloudflare Worker cron. Inactive until TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are set.",
  "scripts": {
    "test": "bun test test",
    "typecheck": "tsc --noEmit",
    "dry-run": "bun scripts/dry-run.ts",
    "check-deploy": "cf deploy --dry-run",
    "deploy": "cf deploy"
  },
  "dependencies": {
    "@focus-garden/protocol": "workspace:*",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@cloudflare/vite-plugin": "^2.0.0-rc.3",
    "@cloudflare/workers-types": "^4.20251120.0",
    "@types/bun": "latest",
    "cf": "1.0.0-rc.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  }
}
